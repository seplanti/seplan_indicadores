{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Seplan Indicadores (app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "cwd": "${workspaceFolder}",
            "args": ["--porta", "8000"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Seplan Indicadores (sem abrir o Chrome)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "cwd": "${workspaceFolder}",
            "args": ["--porta", "8000", "--sem-navegador"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Testes",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "cwd": "${workspaceFolder}",
            "args": ["discover", "-s", "tests"],
            "console": "integratedTerminal"
        }
    ]
}
