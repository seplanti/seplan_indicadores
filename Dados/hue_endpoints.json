  "endpoints": [
    {
      "grupo": "2. Autenticação",
      "nome": "obter_token",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/token/auth/",
      "auth": null,
      "corpo": {
        "tipo": "json",
        "campos": {
          "username": "{{ _.username }}",
          "password": "{{ _.password }}"
        }
      },
      "salvar": {
        "access_token": "access",
        "refresh_token": "refresh"
      }
    },
    {
      "grupo": "2. Autenticação",
      "nome": "validar_token",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/token/verify/",
      "auth": null,
      "corpo": {
        "tipo": "form",
        "campos": {
          "token": "{{ _.access_token }}"
        }
      }
    },
    {
      "grupo": "2. Autenticação",
      "nome": "renovar_token",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/token/refresh/",
      "auth": null,
      "corpo": {
        "tipo": "form",
        "campos": {
          "refresh": "{{ _.refresh_token }}"
        }
      },
      "salvar": {
        "access_token": "access"
      }
    },
    {
      "grupo": "3. SQL",
      "nome": "configuracao",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/get_config/",
      "auth": "bearer"
    },
    {
      "grupo": "3. SQL",
      "nome": "historico",
      "metodo": "GET",
      "url": "{{ _.base_url }}/api/v1/editor/get_history?doc_type={{ _.dialect }}",
      "auth": "bearer"
    },
    {
      "grupo": "3. SQL",
      "nome": "listar_bancos",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/editor/autocomplete/",
      "auth": "bearer",
      "corpo": {
        "tipo": "form",
        "campos": {
          "snippet": "{\"type\":\"{{ _.dialect }}\"}"
        }
      }
    },
    {
      "grupo": "3. SQL",
      "nome": "execute",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/editor/execute/{{ _.dialect }}",
      "auth": "bearer",
      "corpo": {
        "tipo": "form",
        "campos": {
          "statement": "SHOW TABLES IN {{ _.database }}"
        }
      },
      "salvar": {
        "operation_id": "history_uuid"
      }
    },
    {
      "grupo": "3. SQL",
      "nome": "check_status",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/editor/check_status",
      "auth": "bearer",
      "corpo": {
        "tipo": "form",
        "campos": {
          "operationId": "{{ _.operation_id }}"
        }
      }
    },
    {
      "grupo": "3. SQL",
      "nome": "fetch_result",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/editor/fetch_result_data",
      "auth": "bearer",
      "corpo": {
        "tipo": "form",
        "campos": {
          "operationId": "{{ _.operation_id }}"
        }
      }
    },
    {
      "grupo": "3. SQL",
      "nome": "get_logs",
      "metodo": "POST",
      "url": "{{ _.base_url }}/api/v1/editor/get_logs",
      "auth": "bearer",
      "corpo": {
        "tipo": "form",
        "campos": {
          "operationId": "{{ _.operation_id }}"
        }
      }
    },
    {
      "grupo": "4. Arquivos e Conectores",
