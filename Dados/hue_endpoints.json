      "metodo": "GET",
      "url": "{{ _.base_url }}/api/v1/storage/view=/user/{{ _.username }}",
      "auth": "bearer",
      "observacao": "No PDF apontava para /connector/types (repetido de 4.1); corrigido para storage/view, como no guia."
    },
    {
      "grupo": "4. Arquivos e Conectores",
